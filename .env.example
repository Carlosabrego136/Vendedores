# Copia este archivo a .env.local y pon aquí tu cadena de conexión real de
# Aiven (LA MISMA que usa el sistema principal de ENVIOS AYORA), porque esta
# sección lee y ESCRIBE en la misma base de datos: los vendedores que se
# agreguen/editen/desactiven aquí aparecen igual en el panel principal, y
# viceversa.
DATABASE_URL=postgres://usuario:password@host:puerto/basedatos?sslmode=require
